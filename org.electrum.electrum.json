{
    "id": "org.electrum.electrum",
    "runtime": "org.freedesktop.Platform",
    "sdk": "org.freedesktop.Sdk",
    "runtime-version": "24.08",
    "command": "electrum",
    "finish-args": [
        "--socket=x11",
        "--socket=wayland",
        "--share=ipc",
        "--device=all",
        "--share=network",
        "--socket=pulseaudio",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--persist=.electrum"
    ],
    "cleanup": [
        "/include",
        "/share/man/man1"
    ],
    "modules": [
        {
            "name": "electrum",
            "buildsystem": "simple",
            "build-commands": [
                "chmod +x electrum-*.AppImage",
                "./electrum-*.AppImage --appimage-extract >/dev/null",
                "mkdir -p ${FLATPAK_DEST}/electrum",
                "cp -a squashfs-root/. ${FLATPAK_DEST}/electrum/",
                "ln -sf libusb-1.0.so ${FLATPAK_DEST}/electrum/usr/lib/libusb-1.0.so.0",
                "install -Dp -m 644 org.electrum.electrum.metainfo.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml",
                "install -Dp -m 644 squashfs-root/electrum.png ${FLATPAK_DEST}/share/icons/hicolor/128x128/apps/${FLATPAK_ID}.png",
                "install -Dp -m 644 squashfs-root/electrum.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
                "desktop-file-edit --set-key=Icon --set-value=${FLATPAK_ID} ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
                "desktop-file-edit --set-key=Exec --set-value=electrum ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
                "install -Dp -m 755 electrum.sh ${FLATPAK_DEST}/bin/electrum"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://download.electrum.org/4.8.0/electrum-4.8.0-x86_64.AppImage",
                    "sha256": "ed69e145c56d454600116b6efc2ad759d68de288a9d56428bfb48dfcc3b89354",
                    "only-arches": [
                        "x86_64"
                    ],
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 10602,
                        "version-pattern": "^([\\d.]+)$",
                        "url-template": "https://download.electrum.org/$version/electrum-$version-x86_64.AppImage"
                    }
                },
                {
                    "type": "file",
                    "path": "electrum.sh"
                },
                {
                    "type": "file",
                    "path": "org.electrum.electrum.metainfo.xml"
                }
            ]
        }
    ]
}